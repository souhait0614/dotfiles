{ pkgs, primaryUser, self, sharedPackages, ... }:

{
  nix = {
    enable = true;
    package = pkgs.lixPackageSets.stable.lix;
    settings.experimental-features = [ "nix-command" "flakes" ];
  };

  nixpkgs.config.allowUnfree = true;

  system = {
    configurationRevision = self.rev or self.dirtyRev or null;
    primaryUser = primaryUser;
    stateVersion = 7;
  };

  users.users.${primaryUser}.home = "/Users/${primaryUser}";

  environment.systemPackages = sharedPackages;

  fonts.packages = with pkgs; [
{{- range .nix.fonts }}
    {{ . }}
{{- end }}
  ];

  homebrew = {
    enable = true;
    user = primaryUser;
    onActivation = {
      autoUpdate = false;
      cleanup = {{ .homebrew.cleanup | quote }};
      upgrade = false;
    };
    taps = [
{{- range .homebrew.taps }}
      {
        name = {{ . | quote }};
        trusted = true;
      }
{{- end }}
    ];
    brews = [
{{- range .homebrew.brews }}
      {{ . | quote }}
{{- end }}
    ];
    casks = [
{{- range .homebrew.casks }}
      {{ . | quote }}
{{- end }}
    ];
  };

  system.defaults = {
    NSGlobalDomain = {
      AppleShowAllExtensions = true;
      ApplePressAndHoldEnabled = false;
      AppleKeyboardUIMode = 0;
    };
    dock = {
      tilesize = 32;
      "show-recents" = false;
      mineffect = "scale";
      "minimize-to-application" = true;
    };
    finder = {
      ShowPathbar = true;
      ShowStatusBar = true;
      FXPreferredViewStyle = "Nlsv";
      NewWindowTarget = "Home";
    };
    CustomUserPreferences = {
      "com.apple.Spotlight" = {
        MenuItemHidden = 0;
        EnabledPreferenceRules = [
          "Custom.relatedContents"
          "System.menuItems"
          "System.iphoneApps"
        ];
        PasteboardHistoryEnabled = true;
      };
      "com.apple.symbolichotkeys" = {
        AppleSymbolicHotKeys = {
          "64" = {
            enabled = true;
            value = {
              parameters = [ 65535 49 1048576 ];
              type = "standard";
            };
          };
          "65" = {
            enabled = true;
            value = {
              parameters = [ 65535 49 1572864 ];
              type = "standard";
            };
          };
        };
      };
      "com.apple.desktopservices" = {
        DSDontWriteNetworkStores = true;
        DSDontWriteUSBStores = true;
      };
      "com.apple.dock" = {
        size-immutable = true;
      };
      "com.apple.AppleMultitouchTrackpad" = {
        Clicking = 0;
        TrackpadThreeFingerDrag = 0;
        TrackpadRightClick = 1;
      };
    };
  };

  programs.zsh.enable = true;
  security.pam.services.sudo_local.touchIdAuth = true;
}