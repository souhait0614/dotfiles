#!/usr/bin/env bash
set -euo pipefail

# apm.yml hash: {{ include "dot_apm/apm.yml" | sha256sum }}

{{ if not (or (eq .platform "darwin-arm64") (eq .platform "linux-arm64") (eq .platform "linux-x86_64")) -}}
echo "このOS/アーキテクチャではagent skillsの更新をサポートしていません。"
exit 0
{{ end -}}

mise_command=""
if command -v mise >/dev/null 2>&1; then
    mise_command="$(command -v mise)"
elif [ -x "${HOME}/.local/state/nix/profiles/dotfiles-cli/bin/mise" ]; then
    mise_command="${HOME}/.local/state/nix/profiles/dotfiles-cli/bin/mise"
elif [ -x /run/current-system/sw/bin/mise ]; then
    mise_command="/run/current-system/sw/bin/mise"
fi

apm_command=""
if [ -n "${mise_command}" ]; then
    if ! apm_command="$("${mise_command}" which apm 2>/dev/null)"; then
        echo "apmがインストールされていないため、miseでインストールします..."
        "${mise_command}" install apm
        apm_command="$("${mise_command}" which apm)"
    fi
elif command -v apm >/dev/null 2>&1; then
    apm_command="$(command -v apm)"
fi

if [ -z "${apm_command}" ]; then
{{- if not .useSudo }}
    echo "miseが見つからないため、agent skillsの更新をスキップします。"
    exit 0
{{- else }}
    echo "miseが見つからないため、agent skillsを更新できません。" >&2
    exit 1
{{- end }}
fi

echo "agent skillsを更新します..."
"${apm_command}" install -g
