#!/usr/bin/env bash
set -euo pipefail

# generate_config.ts hash: {{ include "deno_scripts/karabiner/generate_config.ts" | sha256sum }}
{{ if eq .platform "darwin-arm64" -}}

mise_command=""
if command -v mise >/dev/null 2>&1; then
	mise_command="$(command -v mise)"
elif [ -x "${HOME}/.local/state/nix/profiles/dotfiles-cli/bin/mise" ]; then
	mise_command="${HOME}/.local/state/nix/profiles/dotfiles-cli/bin/mise"
fi

if [ -z "${mise_command}" ]; then
	echo "miseが見つからないため、Karabiner-Elementsの設定を生成できません。" >&2
	exit 1
fi

echo "Karabiner-Elementsの設定を生成します..."
"${mise_command}" exec deno@2.7.1 -- deno run --allow-read --allow-write --allow-env {{ joinPath .chezmoi.sourceDir "deno_scripts/karabiner/generate_config.ts" | quote }}

{{ end -}}