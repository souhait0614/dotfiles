{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "files.associations": {
    "*.sh.tmpl": "shellscript",
    "*.zsh.tmpl": "shellscript",
    "*.toml.tmpl": "toml",
    "*.nix.tmpl": "nix"
  },
  "deno.enable": true,
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "[json]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  }
}
