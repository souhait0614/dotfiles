{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>souhait0614/renovate-config",
    ":assignAndReview(souhait0614)"
  ],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Lix 2.96.0 breaks socket-activated nix-daemon on systemd (Accept=yes passes LISTEN_FDNAMES=connection), so stay on 2.95.x until fixed upstream",
      "matchPackageNames": ["lix-project/lix"],
      "allowedVersions": "<2.96.0"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Lixのバージョン",
      "managerFilePatterns": ["/^home/\\.chezmoidata/versions\\.toml$/"],
      "matchStrings": [
        "\\[lix\\](?:[\\s\\S]*?)version = \"(?<currentValue>[^\"]+)\"",
        "upgradeScriptVersion = \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "forgejo-tags",
      "registryUrlTemplate": "https://git.lix.systems",
      "packageNameTemplate": "lix-project/lix",
      "versioningTemplate": "semver-coerced"
    }
  ]
}
